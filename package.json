{
  "name": "thermos-claude-plugin-tooling",
  "private": true,
  "type": "module",
  "description": "Maintainer tooling for the thermos-claude-plugin repository. Not part of the plugin.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \".claude/skills/**/*.test.ts\" \"tools/**/*.test.ts\"",
    "mutate": "stryker run",
    "bench": "node tools/stryker-node-test-runner/runner.bench.ts"
  },
  "devDependencies": {
    "@stryker-mutator/api": "^10.0.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "@types/node": "^22.20.5",
    "ajv": "^8.20.0",
    "tinybench": "^6.2.2",
    "typescript": "^6.0.3"
  }
}
